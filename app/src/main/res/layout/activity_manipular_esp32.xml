<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/blanco" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="23dp">
        <TextView android:id="@+id/lblusuario" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:text="Cargando usuario..."
            android:textColor="#122A6C" android:textStyle="bold" android:textSize="22sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:gravity="center" android:text="Manipular Circuito"
            android:textColor="#101216" android:textStyle="bold" android:textSize="24sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center"
            android:text="SIMULACIÓN ACADÉMICA · Sin conexión al ESP32 físico"
            android:textColor="#666666" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="14dp">
            <Button android:id="@+id/btnactivar" android:layout_width="116dp" android:layout_height="104dp"
                android:background="@drawable/boton_circulo" android:backgroundTint="@null" android:text="Activar"
                android:textAllCaps="false" android:textColor="#101216" android:textSize="17sp" android:textStyle="bold" />
            <Space android:layout_width="14dp" android:layout_height="1dp" />
            <Button android:id="@+id/btndesactivar" android:layout_width="116dp" android:layout_height="104dp"
                android:background="@drawable/boton_circulo" android:backgroundTint="@null" android:text="Desactivar"
                android:textAllCaps="false" android:textColor="#101216" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
        <Button android:id="@+id/btnfuga" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="15dp" android:background="@drawable/boton_rojo" android:backgroundTint="@null"
            android:text="SIMULAR FUGA DE GAS" android:textAllCaps="false" android:textColor="@color/blanco" />
        <Button android:id="@+id/btnnormal" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="9dp" android:background="@drawable/boton_negro" android:backgroundTint="@null"
            android:text="Restablecer estado normal" android:textAllCaps="false" android:textColor="@color/blanco" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="15dp" android:orientation="vertical" android:background="@drawable/tarjeta"
            android:padding="15dp">
            <TextView android:id="@+id/lblEstadoGas" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="Cargando..." android:textColor="#333333"
                android:textStyle="bold" android:textSize="18sp" />
            <TextView android:id="@+id/lblSensorGas" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Sensor: -" android:textColor="#262626" android:textSize="15sp" />
            <TextView android:id="@+id/lblCompuertaGas" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="9dp" android:text="Compuerta: -" android:textColor="#262626" android:textSize="15sp" />
            <TextView android:id="@+id/lblLedVerde" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="9dp" android:text="LED verde: -" android:textColor="#262626" android:textSize="15sp" />
            <TextView android:id="@+id/lblLedRojo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="9dp" android:text="LED rojo: -" android:textColor="#262626" android:textSize="15sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center"
            android:text="Estados y acciones guardados en Firebase, compartidos entre Android con la misma cuenta"
            android:textColor="#666666" android:textSize="12sp" />
        <Button android:id="@+id/btnvolver" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="20dp" android:background="@drawable/boton_rojo" android:backgroundTint="@null"
            android:text="Volver" android:textAllCaps="false" android:textColor="@color/blanco" />
    </LinearLayout>
</ScrollView>
