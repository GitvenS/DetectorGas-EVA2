<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/blanco" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="23dp" android:paddingRight="23dp" android:paddingTop="26dp" android:paddingBottom="30dp">
        <TextView android:id="@+id/lblusuario" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Cargando usuario..." android:textColor="#122A6C" android:textStyle="bold" android:textSize="22sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Menú" android:textColor="#101216" android:textStyle="bold" android:textSize="26sp" />
        <Space android:layout_width="1dp" android:layout_height="18dp" />
        <Button android:id="@+id/btnmanipular" android:layout_width="match_parent" android:layout_height="49dp" android:layout_marginTop="10dp" android:background="@drawable/boton_negro" android:backgroundTint="@null" android:text="Manipular Circuito" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="15sp" />
        <Button android:id="@+id/btnacciones" android:layout_width="match_parent" android:layout_height="49dp" android:layout_marginTop="10dp" android:background="@drawable/boton_negro" android:backgroundTint="@null" android:text="Ver Acciones Realizadas" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="15sp" />
        <Button android:id="@+id/btnestadisticas" android:layout_width="match_parent" android:layout_height="49dp" android:layout_marginTop="10dp" android:background="@drawable/boton_negro" android:backgroundTint="@null" android:text="Ver Estadísticas" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="15sp" />
        <Button android:id="@+id/btnperfil" android:layout_width="match_parent" android:layout_height="49dp" android:layout_marginTop="10dp" android:background="@drawable/boton_negro" android:backgroundTint="@null" android:text="Ver Perfil" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="15sp" />
        <Button android:id="@+id/btncerrar" android:layout_width="match_parent" android:layout_height="49dp" android:layout_marginTop="14dp" android:background="@drawable/boton_rojo" android:backgroundTint="@null" android:text="Cerrar Sesión" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="Sistema de detección de fugas de gas" android:textColor="#666666" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>