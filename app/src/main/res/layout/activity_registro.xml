<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/blanco" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="23dp" android:paddingRight="23dp" android:paddingTop="26dp" android:paddingBottom="30dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Crear Cuenta" android:textColor="#101216" android:textStyle="bold" android:textSize="26sp" />
        <Space android:layout_width="1dp" android:layout_height="14dp" />
        <EditText android:id="@+id/txtRutRegistro" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="0dp" android:background="@drawable/campo" android:gravity="center" android:singleLine="true" android:inputType="text" android:hint="Rut" android:textSize="15sp" android:padding="8dp" android:textColorHint="#555555" android:textColor="#111111" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <EditText android:id="@+id/txtNombreRegistro" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="0dp" android:background="@drawable/campo" android:gravity="center" android:hint="Nombre" android:textSize="15sp" android:textColorHint="#555555" android:inputType="textPersonName" android:singleLine="true" />
            <EditText android:id="@+id/txtApellidoRegistro" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/campo" android:gravity="center" android:hint="Apellido" android:textSize="15sp" android:textColorHint="#555555" android:inputType="textPersonName" android:singleLine="true" />
        </LinearLayout>
        <EditText android:id="@+id/txtCorreoRegistro" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/campo" android:gravity="center" android:singleLine="true" android:inputType="textEmailAddress" android:hint="Correo Electrónico" android:textSize="15sp" android:padding="8dp" android:textColorHint="#555555" android:textColor="#111111" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/tarjeta" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="center" android:text="Cargo: Operador   ▾" android:textColor="#242424" android:textSize="15sp" />
        </LinearLayout>
        <EditText android:id="@+id/txtClaveRegistro" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/campo" android:gravity="center" android:singleLine="true" android:inputType="textPassword" android:hint="Contraseña" android:textSize="15sp" android:padding="8dp" android:textColorHint="#555555" android:textColor="#111111" />
        <EditText android:id="@+id/txtConfirmacionRegistro" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/campo" android:gravity="center" android:singleLine="true" android:inputType="textPassword" android:hint="Repetir Contraseña" android:textSize="15sp" android:padding="8dp" android:textColorHint="#555555" android:textColor="#111111" />
        <Button android:id="@+id/btnregistrar" android:layout_width="match_parent" android:layout_height="49dp" android:layout_marginTop="16dp" android:background="@drawable/boton_negro" android:backgroundTint="@null" android:text="Registrar" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="15sp" />
        <Button android:id="@+id/btnvolver" android:layout_width="match_parent" android:layout_height="49dp" android:layout_marginTop="10dp" android:background="@drawable/boton_rojo" android:backgroundTint="@null" android:text="Volver" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Registro protegido con Firebase Authentication." android:textColor="#666666" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>